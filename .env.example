# Root template — prefer configuring secrets in backend/.env (see backend/.env.example).
# Frontend Vite variables belong in frontend/.env (see frontend/.env.example).

# Backend (set these as Vercel *server* Environment Variables — not VITE_*)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
DATABASE_NAME=studyai
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=replace_with_a_long_random_secret
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# TUTOR_MODEL=gemini-3.5-flash-lite
# CORS_ORIGINS=https://your-app.vercel.app
# APP_ENV=production
# FILE_STORAGE_BACKEND=mongo
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Frontend (Vercel one-project): leave unset so the SPA calls same-origin /api
# VITE_API_BASE_URL=
# Never put JWT_SECRET or Mongo/Gemini secrets in VITE_* variables.

# Topology: Vercel (SPA + Python Function) + MongoDB Atlas. See DEPLOYMENT.md.
