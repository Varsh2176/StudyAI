# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
DATABASE_NAME=studyai

# M14 AI Tutor (Gemini) — required for POST /ai/tutor general academic Q&A
# Copy into backend/.env (never commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here
# TUTOR_MODEL=gemini-2.5-flash
# TUTOR_REQUEST_TIMEOUT_SECONDS=20

# M15 PDF upload (local storage under backend/)
# PDF_STORAGE_DIR=storage/documents
# PDF_UPLOAD_MAX_BYTES=10485760

# M16 RAG (local persistent TF-IDF under backend/)
# RAG_STORAGE_DIR=storage/rag
# RAG_EMBEDDING_PROVIDER=local_tfidf
# RAG_CHUNK_WORDS=150
# RAG_CHUNK_OVERLAP=30
# RAG_SIMILARITY_THRESHOLD=0.05
# GEMINI_API_KEY enables grounded LLM answers; without it, retrieval-only mode is labelled.
