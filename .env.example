# Root template — prefer configuring secrets in backend/.env (see backend/.env.example).
# Frontend Vite variables belong in frontend/.env (see frontend/.env.example).

# Backend (also listed in backend/.env.example)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
DATABASE_NAME=studyai
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=replace_with_a_long_random_secret
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# TUTOR_MODEL=gemini-3.5-flash-lite
# CORS_ORIGINS=https://your-app.vercel.app
# APP_ENV=production
# PDF_STORAGE_DIR=/var/data/documents
# RAG_STORAGE_DIR=/var/data/rag
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Frontend / Vercel build (also listed in frontend/.env.example)
# VITE_API_BASE_URL=https://your-api.onrender.com
# Never put JWT_SECRET or Mongo/Gemini secrets in VITE_* variables.

# Hybrid topology: see DEPLOYMENT.md §12 (Vercel frontend + Render Docker API).
