# Frontend environment (Vite). Values prefixed with VITE_ are embedded in the client bundle.
# Never put MongoDB URIs, Gemini keys, JWT secrets, or passwords in VITE_* variables.

# Public backend API base URL (no trailing slash).
# Local development: leave unset to use http://127.0.0.1:8000
# Hybrid production (Vercel frontend + Render API): set this in the Vercel project
# as a Build Environment Variable before `npm run build`, e.g.:
#   VITE_API_BASE_URL=https://studywise-api.onrender.com
# Production (same-origin reverse proxy): leave unset so requests use the page origin.
# VITE_API_BASE_URL=https://your-api.onrender.com

# Vercel project settings (Root Directory = frontend):
#   Build Command: npm run build
#   Output Directory: dist
#   SPA rewrites: see frontend/vercel.json
