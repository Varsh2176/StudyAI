# Frontend environment (Vite). Values prefixed with VITE_ are embedded in the client bundle.
# Never put MongoDB URIs, Gemini keys, JWT secrets, or passwords in VITE_* variables.

# Public backend API base URL (no trailing slash).
# Local development: leave unset to use http://127.0.0.1:8000 (FastAPI at repo backend/).
# Vercel one-project production: leave unset so the client calls same-origin /api
#   (root vercel.json rewrites /api/* to the Python function).
# Split hosting only: set an absolute https URL, e.g. https://api.example.com
# VITE_API_BASE_URL=https://your-api.example.com

# Vercel (recommended): import the repository root, not frontend/.
# Root Directory: (repository root)
# Build: see root vercel.json
# Never put JWT_SECRET, MONGODB_URI, or GEMINI_API_KEY in VITE_* variables.
