# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
DATABASE_NAME=studyai

# ---------------------------------------------------------------------------
# M14 AI Tutor (required for general academic Q&A at POST /ai/tutor)
# ---------------------------------------------------------------------------
# Get a key from Google AI Studio / Gemini API, then set it here.
# Never commit real keys. Keep secrets only in backend/.env (gitignored).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional aliases / tuning
# GOOGLE_API_KEY=         # accepted as an alternate name for GEMINI_API_KEY
# TUTOR_MODEL=gemini-2.5-flash
# TUTOR_REQUEST_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Notes RAG synthesis (existing M15–M16 path at POST /ai/ask)
# ---------------------------------------------------------------------------
# If GEMINI_API_KEY is omitted, grounded note Q&A falls back to offline
# extractive answers with citations (no general conversational tutoring).
