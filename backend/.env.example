# Copy to backend/.env for local development. Never commit real credentials.

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
DATABASE_NAME=studyai
# Diagnose connectivity (no secrets in response): GET /health/database

# ---------------------------------------------------------------------------
# CORS (production)
# ---------------------------------------------------------------------------
# Comma-separated frontend origins allowed to call the API.
# Leave unset for local-dev defaults (localhost:5173 / 5174 / 3000).
# When APP_ENV=production, CORS_ORIGINS is REQUIRED (fail-closed if unset).
# Same-origin Vercel (SPA + /api on one domain): optional but recommended:
# CORS_ORIGINS=https://your-app.vercel.app
# Example production:
# CORS_ORIGINS=https://your-frontend.example.com,https://www.your-frontend.example.com

# ---------------------------------------------------------------------------
# Gemini study generation + LLM-grounded Documents RAG
# ---------------------------------------------------------------------------
# Used by Learning Hub tools (flashcards, mind maps, practice, mock exams,
# topic summaries) via POST /ai/tutor, and by Documents RAG grounded answers.
# Never commit real keys. Keep secrets only in backend/.env (gitignored).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional aliases / tuning
# GOOGLE_API_KEY=         # accepted as an alternate name for GEMINI_API_KEY
# TUTOR_MODEL=gemini-3.5-flash-lite
# TUTOR_REQUEST_TIMEOUT_SECONDS=40
# TUTOR_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# M15 PDF Upload (local storage + text extraction)
# ---------------------------------------------------------------------------
# PDF bytes: local disk in development; MongoDB GridFS on Vercel (no durable disk).
# Metadata and extracted page text are stored in MongoDB collection "documents".
# FILE_STORAGE_BACKEND=disk
# FILE_STORAGE_BACKEND=mongo
# On Vercel, mongo GridFS is used automatically (VERCEL=1) even if this is unset.
PDF_STORAGE_DIR=storage/documents
PDF_UPLOAD_MAX_BYTES=10485760
# PDF_MAX_EXTRACTED_CHARS=500000
# PDF_MAX_PAGES=200

# ---------------------------------------------------------------------------
# M16 RAG over uploaded documents (TF-IDF index)
# ---------------------------------------------------------------------------
# Disk in local dev; MongoDB GridFS on Vercel. GEMINI_API_KEY optional for LLM answers.
RAG_STORAGE_DIR=storage/rag
RAG_EMBEDDING_PROVIDER=local_tfidf
# RAG_CHUNK_WORDS=150
# RAG_CHUNK_OVERLAP=30
# RAG_SIMILARITY_THRESHOLD=0.05

# ---------------------------------------------------------------------------
# Legacy notes upload at POST /ai/notes/upload (pre-M15 path)
# ---------------------------------------------------------------------------
# Still available; prefer POST /documents/upload for secure PDF handling.

# ---------------------------------------------------------------------------
# M10 Authentication (required for production)
# ---------------------------------------------------------------------------
# Strong random secret used to sign short-lived access tokens.
# Generate e.g. with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_secret
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# APP_ENV=production   # when set to production/prod, JWT_SECRET must not be a placeholder
# Vercel: set APP_ENV=production and a strong JWT_SECRET in the Vercel project env.
# M11 auth abuse controls (in-process; per worker):
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
